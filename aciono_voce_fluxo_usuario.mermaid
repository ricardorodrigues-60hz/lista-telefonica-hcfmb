---
title: "Aciono Você — Fluxo de Usuário"
---
flowchart TD
    %% ── Estilos ──────────────────────────────────────────────────────────────
    classDef inicio        fill:#008B95,stroke:#006B73,color:#fff,font-weight:bold
    classDef decisao       fill:#FFF8E1,stroke:#FFE082,color:#5D4037
    classDef acaoGestor    fill:#EDE7F6,stroke:#9C27B0,color:#4A148C
    classDef acaoConsultor fill:#E8F5E9,stroke:#4CAF50,color:#1B5E20
    classDef sistema       fill:#E3F2FD,stroke:#1976D2,color:#0D47A1
    classDef erro          fill:#FFEBEE,stroke:#EF9A9A,color:#B71C1C
    classDef offline       fill:#FFF3E0,stroke:#FFB74D,color:#E65100
    classDef fim           fill:#ECEFF1,stroke:#90A4AE,color:#37474F

    %% ── Entrada ─────────────────────────────────────────────────────────────
    A([🏥 Usuário acessa o sistema]):::inicio
    A --> B{Possui sessão\nJWT válida?}:::decisao

    B -- Não --> C[Tela de Login\ne-mail + senha]:::sistema
    C --> D{Credenciais\ncorretas?}:::decisao
    D -- Não --> E[Exibe erro\nTentativa registrada]:::erro
    E --> C
    D -- Sim --> F[Gera Access Token\n15 min + Refresh Token 7d]:::sistema
    F --> G{Qual papel\ndo usuário?}:::decisao

    B -- Sim --> G

    %% ── Bifurcação de papéis ─────────────────────────────────────────────
    G -- CONSULTOR --> H([🔍 Tela: Lista Telefônica]):::acaoConsultor
    G -- GESTOR --> I([🛡️ Tela: Lista + Painel Gestor]):::acaoGestor

    %% ── Fluxo Consultor ─────────────────────────────────────────────────
    H --> J{Dispositivo\nonline?}:::decisao

    J -- Sim --> K[Requisição GET /api/contatos\npara o backend FastAPI]:::sistema
    K --> L[Atualiza IndexedDB local\ncom dados do servidor]:::sistema
    L --> M[Exibe lista a partir\ndo IndexedDB]:::acaoConsultor

    J -- Não --> N[Exibe lista a partir\ndo IndexedDB offline]:::offline
    N --> O[⚠️ Indicador visual:\nDados podem estar desatualizados]:::offline

    M --> P{Usuário busca\num contato?}:::decisao
    O --> P
    P -- Sim --> Q[Filtra por nome, ramal,\nsetor ou tipo]:::acaoConsultor
    Q --> R[Abre detalhe do contato:\nRamal + número externo se houver]:::acaoConsultor
    P -- Não --> H

    %% ── Fluxo Gestor ─────────────────────────────────────────────────────
    I --> S{O que o\nGestor quer fazer?}:::decisao

    S -- Adicionar contato --> T[Preenche formulário:\nnome, setor, ramal, número externo]:::acaoGestor
    T --> U{Online?}:::decisao
    U -- Sim --> V[POST /api/contatos\nSalva no SQLite]:::sistema
    U -- Não --> W[Salva no IndexedDB\nsincronizado: false]:::offline
    W --> X[⚠️ Ícone Pendente\nna interface]:::offline

    S -- Editar contato --> Y[Edita campos\ndo registro]:::acaoGestor
    Y --> V

    S -- Inativar contato --> Z[Soft delete:\nis_active = false\nRegistro preservado]:::acaoGestor
    Z --> V

    S -- Gerenciar usuários --> AA[Cria, bloqueia ou\naltera papel de usuário]:::acaoGestor
    AA --> V

    %% ── Sincronização ────────────────────────────────────────────────────
    V --> AB[Grava Audit Trail:\nquem, o quê, quando]:::sistema
    X --> AC{Conexão\nrestabelecida?}:::decisao
    AC -- Sim --> AD[Service Worker detecta\nevento 'online']:::sistema
    AD --> AE[Varre IndexedDB:\nsincronizado = false]:::sistema
    AE --> AF[POST /api/sync\nEnvia lote pendente]:::sistema
    AF --> AG[Servidor compara\natualizado_em e persiste]:::sistema
    AG --> AH[Atualiza IndexedDB:\nsincronizado = true]:::sistema
    AH --> AI[Remove indicadores\nde pendência na UI]:::acaoGestor

    %% ── Token expirado ───────────────────────────────────────────────────
    AB --> AJ{Token\nexpirou?}:::decisao
    AJ -- Sim --> AK[Usa Refresh Token\npara renovar sessão]:::sistema
    AK --> AJ
    AJ -- Não --> AL([✅ Operação concluída]):::fim
    AI --> AL
    R --> AL
